# EditorConfig 帮助跨编辑器保持一致性
# https://editorconfig.org/

root = true

# 所有文件
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2

# Markdown 文件
[*.md]
trim_trailing_whitespace = false

# JSON/JS/TS 文件
[*.{json,js,jsx,ts,tsx}]
indent_size = 2

# CSS 文件
[*.{css,scss,less}]
indent_size = 2

# YAML 文件
[*.{yml,yaml}]
indent_size = 2
